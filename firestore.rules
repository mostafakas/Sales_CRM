rules_version = '2';
// AL MASTER HR — Firestore security rules.
// Roles live on users/{email}.role: employee | leader | hr | finance | admin  (legacy "supervisor" = hr).
// Deploy with:  firebase deploy --only firestore:rules   (or paste into Console → Firestore → Rules → Publish)
// Principles: deny by default · every rule requires an active (non-suspended) profile · nobody edits their own
// role, permissions, salary, balance or corrected attendance · payroll/finance access is granted by admins only.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }
    function uPath(email) { return /databases/$(database)/documents/users/$(email); }
    function hasProfile() { return signedIn() && exists(uPath(me())); }
    function prof() { return get(uPath(me())).data; }
    function active() { return hasProfile() && prof().get('isSuspended', false) != true; }
    function role() { return prof().get('role', 'employee'); }
    function isAdmin() { return active() && role() == 'admin'; }
    function isHR() { return active() && role() in ['hr', 'supervisor', 'admin']; }
    function isPM() { return active() && role() == 'pm'; }
    // company-wide read access (HR, project managers)
    function seesAll() { return isHR() || isPM(); }
    function isFinance() { return active() && (role() in ['finance', 'admin'] || prof().get('permissions', {}).get('payroll', false) == true); }
    function hasCRM() { return active() && (role() == 'admin' || prof().get('permissions', {}).get('crm', false) == true); }
    function leads(email) { return exists(uPath(email)) && get(uPath(email)).data.get('leaderEmail', '') == me(); }
    function recoveryOk(d) { return d.get('contactEmail', '') == '' || (d.contactEmail is string && d.contactEmail.size() < 120 && d.contactEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')); }
    function payrollOf(d) { return d.get('permissions', {}).get('payroll', false) == true; }
    // HR/finance may manage everyone's records except their own (admins may do both)
    function othersOnly() {
      return isAdmin() || ((resource == null || resource.data.get('email', '') != me())
                        && (request.resource == null || request.resource.data.get('email', '') != me()));
    }

    // ---------- helpers ----------
    function affected() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return affected().hasOnly(keys); }
    function nowMs() { return request.time.toMillis(); }
    function near(ms) { return ms is number && ms >= nowMs() - 300000 && ms <= nowMs() + 300000; }
    function settingsPath() { return /databases/$(database)/documents/settings/general; }
    function defaultWf(t) {
      return t == 'letter' ? ['hr'] : ((t == 'leave' || t == 'correction') ? ['leader', 'hr'] : (t == 'advance' ? ['leader', 'hr', 'finance'] : ['leader']));
    }
    function wfList(t) { return exists(settingsPath()) ? get(settingsPath()).data.get('workflow', {}).get(t, defaultWf(t)) : defaultWf(t); }
    // the first approval stage the requester must go through
    function firstStatusOk(d) {
      return (prof().get('leaderEmail', '') != '' && wfList(d.type).hasAny(['leader']))
        ? d.status == 'pending_leader'
        : d.status in (d.type == 'advance' ? ['pending_hr', 'pending_finance'] : ['pending_hr']);
    }
    // a check-in must happen on the work day it is filed under (Cairo day, generous window)
    function dayWindowOk(d) {
      let p = d.split('-');
      let t0 = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return request.time > t0 - duration.value(4, 'h') && request.time < t0 + duration.value(32, 'h');
    }
    function workSum(d) { return d.get('workMs', 0) + d.get('breakMs', 0) + d.get('meetingMs', 0); }
    // grace period (settings → work hours); a check-in inside it is credited as work from the start of the shift
    function graceMs() { return (exists(settingsPath()) ? get(settingsPath()).data.get('graceMinutes', 15) : 15) * 60000 + 120000; }
    function tbSum(m) { return m.get('Online', 0) + m.get('Break', 0) + m.get('Meeting', 0); }
    function timeBankOk() {
      return !('timeBank' in affected())
        || ('lastChange' in affected() && (
             // a new work day starts from zero (+ the grace-period credit, as work only)
             (request.resource.data.get('dayKey', '') != resource.data.get('dayKey', '')
                 && request.resource.data.timeBank.get('Break', 0) == 0 && request.resource.data.timeBank.get('Meeting', 0) == 0
                 && request.resource.data.timeBank.get('Online', 0) >= 0 && request.resource.data.timeBank.get('Online', 0) <= graceMs())
             // legacy docs without a server timestamp
             || !(resource.data.get('lastChange', null) is timestamp)
             // same day: counters can grow at most by the real elapsed time (+2 min tolerance)
             || (request.resource.data.get('dayKey', '') == resource.data.get('dayKey', '')
                 && tbSum(request.resource.data.timeBank) >= 0
                 && tbSum(request.resource.data.timeBank) <= tbSum(resource.data.get('timeBank', {})) + (nowMs() - resource.data.lastChange.toMillis()) + 120000)
           ));
    }

    // ---------- users (public profile + live status) ----------
    match /users/{email} {
      function newDay() { return request.resource.data.get('dayKey', '') != resource.data.get('dayKey', ''); }
      allow get: if (signedIn() && email == me()) || active();
      allow list: if active();

      // HR creates accounts; only admins create admin / finance accounts or grant payroll access
      allow create: if isHR() && email == email.lower()
        && (isAdmin() || (!(request.resource.data.get('role', 'employee') in ['admin', 'finance', 'pm']) && !payrollOf(request.resource.data)));
      allow delete: if isAdmin() && email != me();

      // HR / admin edit profiles. Non-admin HR: never admin accounts, never finance role or payroll access,
      // and never their own role, permissions or suspension.
      allow update: if isHR() && (isAdmin() || (
            resource.data.get('role', '') != 'admin'
         && request.resource.data.get('role', '') != 'admin'
         && (!('role' in affected()) || (!(resource.data.get('role', '') in ['finance', 'pm']) && !(request.resource.data.role in ['finance', 'pm'])))
         && payrollOf(request.resource.data) == payrollOf(resource.data)
         && (email != me() || !affected().hasAny(['role', 'permissions', 'isSuspended']))
      ));

      // A leader may clear the "remote pending" flag for a team member
      allow update: if active() && resource.data.get('leaderEmail', '') == me() && onlyChanged(['remotePending'])
        && request.resource.data.remotePending == false;

      // A leader may switch a team member's live status (break / meeting / working / end of day).
      // Same limits as self-service: server clock, and counters grow at most by the real elapsed time.
      allow update: if active() && email != me() && resource.data.get('leaderEmail', '') == me()
        && resource.data.get('isSuspended', false) != true
        && onlyChanged(['status', 'lastChange', 'lastChangeClient', 'timeBank', 'checkedOut'])
        && request.resource.data.status in ['Online', 'Break', 'Meeting', 'Offline']
        && request.resource.data.lastChange == request.time
        && timeBankOk();

      // Self-service: live attendance fields only, with server-verified clock and bounded time
      allow update: if signedIn() && email == me()
        && resource.data.get('isSuspended', false) != true
        && onlyChanged(['status', 'lastChange', 'lastChangeClient', 'timeBank', 'firstOnlineAt', 'dayKey', 'workLocation',
                        'remotePending', 'checkedOut', 'sessionId', 'lastLoginAt', 'photo', 'lang', 'mustChangePassword'])
        && (!('status' in affected()) || request.resource.data.status in ['Online', 'Break', 'Meeting', 'Offline'])
        && (!('dayKey' in affected()) || request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('lastChange' in affected()) || request.resource.data.lastChange == request.time)
        && (!('lastLoginAt' in affected()) || request.resource.data.lastLoginAt == request.time)
        && (!('firstOnlineAt' in affected()) || request.resource.data.firstOnlineAt == request.time || request.resource.data.firstOnlineAt == null)
        && (!('mustChangePassword' in affected()) || request.resource.data.mustChangePassword == false)
        // work location and the "remote without approval" flag are set once, when the day starts
        && (!('workLocation' in affected()) || newDay() || resource.data.get('workLocation', null) == null)
        && (!('remotePending' in affected()) || newDay() || request.resource.data.remotePending == true)
        && (!('photo' in affected()) || (request.resource.data.photo is string && request.resource.data.photo.size() < 120000))
        && (!('sessionId' in affected()) || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() < 64))
        && timeBankOk();
    }

    // ---------- salary, bank, contract (restricted) ----------
    match /employees_private/{email} {
      allow get: if active() && email == me();
      allow read: if isHR() || isFinance();
      allow write: if (isHR() || isFinance()) && (email != me() || isAdmin());
      // employees may set their own recovery email (used for "Forgot password?")
      allow create: if active() && email == me() && request.resource.data.keys().hasOnly(['email', 'contactEmail', 'updatedAt'])
        && request.resource.data.email == me() && recoveryOk(request.resource.data);
      allow update: if active() && email == me() && onlyChanged(['contactEmail', 'updatedAt']) && recoveryOk(request.resource.data);
    }

    // ---------- settings ----------
    match /settings/{doc} {
      // settings/public = login domain + password-service URL, needed on the sign-in page before login
      allow get: if doc == 'public';
      allow read: if active();
      allow write: if isHR() && (doc != 'public' || isAdmin());
    }
    match /_clock/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- attendance ----------
    match /attendance_days/{id} {
      function selfKeys() {
        return ['email', 'name', 'date', 'leaderEmail', 'department', 'mode', 'remotePending', 'checkIn', 'checkInMs', 'checkOutMs',
                'workMs', 'breakMs', 'meetingMs', 'closed', 'closedBy', 'autoClosed', 'corrected', 'updatedAt', 'creditMs'];
      }
      function creditOk(d) { return d.get('creditMs', 0) is number && d.get('creditMs', 0) >= 0 && d.get('creditMs', 0) <= graceMs(); }
      function checkOutOk(d) {
        return d.get('checkOutMs', null) == null
          || (d.checkOutMs <= nowMs() + 300000 && (d.get('autoClosed', false) == true || d.checkOutMs >= nowMs() - 300000));
      }
      allow read: if active() && (resource == null || resource.data.email == me() || seesAll() || isFinance() || resource.data.get('leaderEmail', '') == me());
      // HR corrections (not on their own days)
      allow write: if isHR() && othersOnly();
      // self create (start of day, or closing a forgotten day)
      allow create: if active() && request.resource.data.email == me() && id == me() + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(selfKeys())
        && request.resource.data.get('corrected', false) == false
        && request.resource.data.get('closedBy', '') in ['', 'user', 'auto']
        && creditOk(request.resource.data)
        && (!('checkIn' in request.resource.data) || (request.resource.data.checkIn == request.time && dayWindowOk(request.resource.data.date)))
        && (!('checkInMs' in request.resource.data) || near(request.resource.data.checkInMs))
        && checkOutOk(request.resource.data);
      // self update (status changes, end of day)
      allow update: if active() && resource.data.email == me() && request.resource.data.email == me()
        && onlyChanged(['workMs', 'breakMs', 'meetingMs', 'checkOutMs', 'closed', 'closedBy', 'autoClosed', 'updatedAt', 'remotePending'])
        && request.resource.data.get('closedBy', '') in ['', 'user', 'auto']
        && (!('remotePending' in affected()) || request.resource.data.remotePending == true)
        && workSum(request.resource.data) <= nowMs() - resource.data.get('checkInMs', 0) + resource.data.get('creditMs', 0) + 300000
        && checkOutOk(request.resource.data);
      // self first check-in on a day doc that exists without one (pre-created by HR or migration)
      allow update: if active() && resource.data.email == me() && request.resource.data.email == me()
        && resource.data.get('checkIn', null) == null && resource.data.get('corrected', false) == false
        && onlyChanged(selfKeys())
        && request.resource.data.get('closedBy', '') in ['', 'user', 'auto']
        && creditOk(request.resource.data)
        && (!('checkIn' in affected()) || (request.resource.data.checkIn == request.time && dayWindowOk(request.resource.data.date)))
        && (!('checkInMs' in affected()) || near(request.resource.data.checkInMs))
        && checkOutOk(request.resource.data);
      // leader clears "remote pending" after approving
      allow update: if active() && resource.data.get('leaderEmail', '') == me() && onlyChanged(['remotePending', 'updatedAt']) && request.resource.data.remotePending == false;
      // leader updates a team member's day when switching their status or ending / auto-closing it
      allow update: if active() && resource.data.email != me() && leads(resource.data.email)
        && request.resource.data.email == resource.data.email
        && onlyChanged(['workMs', 'breakMs', 'meetingMs', 'checkOutMs', 'closed', 'closedBy', 'autoClosed', 'updatedAt'])
        && request.resource.data.get('closedBy', '') in ['', 'leader']
        && workSum(request.resource.data) <= nowMs() - resource.data.get('checkInMs', 0) + resource.data.get('creditMs', 0) + 300000
        && checkOutOk(request.resource.data);
      // leader closes a forgotten day of a team member that has no record yet (no check-in, flagged auto-closed)
      allow create: if active() && request.resource.data.email != me() && leads(request.resource.data.email)
        && id == request.resource.data.email + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['email', 'date', 'workMs', 'breakMs', 'meetingMs', 'checkOutMs', 'closed', 'closedBy', 'autoClosed', 'updatedAt'])
        && request.resource.data.closedBy == 'leader' && request.resource.data.autoClosed == true
        && checkOutOk(request.resource.data);
    }
    match /logs/{id} {
      allow read: if active() && (resource.data.user == me() || seesAll() || resource.data.get('leaderEmail', '') == me());
      allow create: if active() && (request.resource.data.user == me() || isHR() || leads(request.resource.data.user)) && request.resource.data.timestamp == request.time;
      // only re-pointed when an admin changes someone's username
      allow update: if isAdmin() && onlyChanged(['user', 'leaderEmail']);
      allow delete: if isAdmin();
    }
    match /schedules/{id} {
      allow read: if active() && (resource == null || resource.data.email == me() || seesAll() || isFinance() || resource.data.get('leaderEmail', '') == me());
      allow write: if (isHR() && othersOnly())
        || (active() && request.resource != null && leads(request.resource.data.email) && request.resource.data.get('leaderEmail', '') == me()
            && (resource == null || resource.data.email == request.resource.data.email));
    }

    // ---------- requests ----------
    match /requests/{id} {
      function stageFields() { return ['status', 'updatedAt', 'history', 'decidedBy', 'approvedBy', 'approvedAt']; }
      allow read: if active() && (resource.data.email == me() || resource.data.get('leaderEmail', '') == me() || seesAll() || isFinance());
      // HR/admin may file on someone else's behalf (and the migration imports old requests); own requests follow the normal path
      allow create: if (isHR() && othersOnly()) || (active()
        && request.resource.data.email == me()
        && request.resource.data.get('leaderEmail', '') == prof().get('leaderEmail', '')
        && request.resource.data.type in ['leave', 'remote', 'excuse', 'mission', 'correction', 'advance', 'letter']
        && firstStatusOk(request.resource.data));
      // requester cancels while pending
      allow update: if active() && resource.data.email == me() && resource.data.status.matches('pending_.*')
        && request.resource.data.status == 'cancelled' && onlyChanged(['status', 'updatedAt', 'history']);
      // direct manager decides the leader stage (never their own request)
      allow update: if active() && resource.data.get('leaderEmail', '') == me() && resource.data.email != me()
        && resource.data.status == 'pending_leader'
        && request.resource.data.status in ['pending_hr', 'pending_finance', 'approved', 'rejected']
        && onlyChanged(stageFields());
      // finance decides the finance stage
      allow update: if isFinance() && resource.data.email != me() && resource.data.status == 'pending_finance'
        && request.resource.data.status in ['approved', 'rejected'] && onlyChanged(stageFields());
      // HR: any decision, revoke, response (own requests only for admins)
      allow update: if isHR() && (resource.data.email != me() || isAdmin());
      allow delete: if isAdmin();
    }
    match /attachments/{id} {
      allow read: if active() && (resource.data.owner == me() || isHR() || isFinance() || resource.data.get('leaderEmail', '') == me());
      allow create: if active() && request.resource.data.owner == me() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if active() && (resource.data.owner == me() || isHR());
      allow update: if isAdmin() && onlyChanged(['owner', 'leaderEmail']);
    }

    // ---------- leave balances ----------
    match /balances/{id} {
      allow read: if active() && (resource == null || resource.data.email == me() || seesAll() || isFinance() || leads(resource.data.email));
      allow write: if isHR() && othersOnly();
    }
    match /balance_ledger/{id} {
      allow read: if active() && (resource.data.email == me() || isHR() || isFinance());
      allow create: if isHR() && othersOnly() && request.resource.data.by == me();
      allow update: if isAdmin() && onlyChanged(['email']);
    }

    // ---------- money ----------
    match /advances/{id} {
      allow read: if active() && (resource.data.email == me() || isHR() || isFinance());
      allow write: if (isHR() || isFinance()) && othersOnly();
    }
    match /payroll_runs/{month} {
      allow read: if isHR() || isFinance();
      allow write: if isFinance();
    }
    match /payroll_items/{id} {
      allow read: if isFinance() || isHR() || (active() && resource.data.email == me() && resource.data.published == true);
      allow write: if isFinance();
    }
    match /treasury/{id} {
      allow read, write: if isFinance();
    }

    // ---------- reports, notifications, audit ----------
    match /monthly_reports/{month} {
      allow read: if isHR() || isFinance();
      allow write: if isHR();
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.to == me();
      allow create: if active() && request.resource.data.from == me() && request.resource.data.to is string
        && request.resource.data.get('read', false) == false && request.resource.data.get('title', '').size() < 300;
      allow update: if signedIn() && resource.data.to == me() && onlyChanged(['read']);
      allow delete: if signedIn() && resource.data.to == me();
    }
    // ---------- chat (1:1) ----------
    function chatDoc(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function inChat(id) { return active() && me() in chatDoc(id).members; }
    match /chats/{id} {
      allow read: if active() && (resource == null || me() in resource.data.members || isAdmin());
      allow create: if active()
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '__' + request.resource.data.members[1]
        && exists(uPath(request.resource.data.members[0])) && exists(uPath(request.resource.data.members[1]));
      // members: last message, unread counters, read receipts
      allow update: if active() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && onlyChanged(['lastMessage', 'updatedAt', 'unread', 'lastRead']);
      // admin: archive
      allow update: if isAdmin() && request.resource.data.members == resource.data.members
        && onlyChanged(['archivedAt', 'archivedBy', 'archivedCount', 'lastMessage', 'updatedAt']);
      allow delete: if isAdmin();

      match /messages/{m} {
        allow read: if isAdmin() || inChat(id);
        allow create: if inChat(id) && request.resource.data.by == me() && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['by', 'type', 'text', 'file', 'at'])
          && request.resource.data.type in ['text', 'image', 'file']
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && (!('file' in request.resource.data) || (request.resource.data.file is map && request.resource.data.file.get('thumb', '').size() < 150000));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    match /chat_archive/{id} {
      allow read, write: if isAdmin();
      match /messages/{m} { allow read, write: if isAdmin(); }
    }
    match /chat_files/{f} {
      allow read: if active() && (isAdmin() || me() in chatDoc(resource.data.chatId).members);
      allow create: if active() && request.resource.data.by == me() && me() in chatDoc(request.resource.data.chatId).members
        && request.resource.data.size is number && request.resource.data.size <= 5300000 && request.resource.data.chunks is int && request.resource.data.chunks <= 10;
      allow delete: if isAdmin();
      match /chunks/{i} {
        function fileDoc() { return get(/databases/$(database)/documents/chat_files/$(f)).data; }
        allow read: if active() && (isAdmin() || me() in chatDoc(fileDoc().chatId).members);
        allow create: if active() && fileDoc().by == me() && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
        allow delete: if isAdmin();
      }
    }

    // what each user did (sign-ins, requests, approvals, settings…) — admins only
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.by == me() && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['by', 'name', 'action', 'target', 'detail', 'at'])
        && request.resource.data.action is string && request.resource.data.action.size() < 60
        && request.resource.data.get('detail', '').size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /audit_log/{id} {
      allow read: if isHR();
      allow create: if (isHR() || isFinance()) && request.resource.data.by == me();
      allow update, delete: if false;
    }

    // ---------- CRM / sales apps ----------
    match /sales_leads/{id} { allow read, write: if hasCRM(); }
    match /crm_settings/{id} { allow read, write: if hasCRM(); }
    match /clients/{id} { allow read, write: if hasCRM(); }
    match /projects/{id} { allow read, write: if hasCRM(); }
    match /expenses/{id} { allow read, write: if hasCRM(); }
    match /invoices/{id} { allow read, write: if hasCRM(); }

    // ---------- old system (read-only, kept for the migration; admin only) ----------
    match /system_settings/{doc} { allow read: if active(); allow write: if false; }
    match /hr_stats/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /leave_requests/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /monthly_schedules/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /financial_months/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /attendance_override/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /work_mode_requests/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /attendance_records/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /freelancers/{doc} { allow read: if isAdmin(); allow write: if false; }
    // features no page uses any more (chat, tasks, screenshots, shared-tool queue) — closed.
    // They were readable/writable by ANY signed-in user under the old rules.
    match /messages/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /private_messages/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /typing_status/{doc} { allow read, write: if false; }
    match /tasks/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /screenshot_requests/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /tool_requests/{doc} { allow read: if isAdmin(); allow write: if false; }
    match /_serverTime/{doc} { allow read, write: if false; }

    // everything else: denied
  }
}
